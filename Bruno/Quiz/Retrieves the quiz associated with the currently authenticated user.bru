meta {
  name: Retrieves the quiz associated with the currently authenticated user.
  type: http
  seq: 1
  tags: [
    Quiz
  ]
}

get {
  url: {{baseUrl}}/Quiz/MyQuiz
  body: none
  auth: inherit
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/Quiz/MyQuiz
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "scoreRequired": 0,
          "questions": [
            {
              "questionText": "",
              "type": 0,
              "options": [
                {
                  "text": ""
                }
              ],
              "correctOptionIndex": 0,
              "score": 0
            }
          ]
        }
      '''
    }
  }
}

