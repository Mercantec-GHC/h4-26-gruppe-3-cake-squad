meta {
  name: Retrieves a paginated list of messages from a specified chat room.
  type: http
  seq: 8
  tags: [
    Chat
  ]
}

post {
  url: {{baseUrl}}/Chat/messages/getMessages
  body: json
  auth: inherit
}

body:json {
  {
    "chatRoomId": "",
    "cursor": ""
  }
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/Chat/messages/getMessages
    method: POST
    mode: json
    body:json: {
      {
        "chatRoomId": "",
        "cursor": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "messageObjects": [
            {
              "id": 0,
              "createdAt": "",
              "sender": {
                "id": "",
                "firstName": "",
                "lastName": ""
              },
              "messageContent": ""
            }
          ],
          "nextCursor": "",
          "hasMore": false
        }
      '''
    }
  }
}

