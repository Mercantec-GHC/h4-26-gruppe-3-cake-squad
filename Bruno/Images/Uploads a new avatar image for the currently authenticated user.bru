meta {
  name: Uploads a new avatar image for the currently authenticated user.
  type: http
  seq: 2
  tags: [
    Images
  ]
}

post {
  url: {{baseUrl}}/Images/Avatar/Upload
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  file: @file()
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/Images/Avatar/Upload
    method: POST
    mode: multipartForm
    body:multipart-form: {
      file: @file()
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
