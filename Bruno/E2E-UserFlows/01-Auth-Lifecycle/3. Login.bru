meta {
  name: 3. Login
  type: http
  seq: 3
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/Auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "{{e2eEmail}}",
    "password": "{{e2ePassword}}"
  }
}

script:post-response {
  if (res.status === 200) {
      const d = typeof res.body === "string" ? JSON.parse(res.body) : (res.body || {});
      const authJwtToken = d?.jwtToken;
      const authRefreshToken = d?.refreshToken;
    
      if (authJwtToken) bru.setVar("authJwtToken", String(authJwtToken));
      if (authRefreshToken) bru.setVar("authRefreshToken", String(authRefreshToken));
  }
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/Auth/login
    method: POST
    mode: json
    body:json: {
      {
        "email": "",
        "password": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "jwtToken": "",
          "refreshToken": "",
          "expires": 0
        }
      '''
    }
  }
}

