meta {
  name: 7. Obtain user info again.
  type: http
  seq: 7
  tags: [
    Auth
  ]
}

get {
  url: {{baseUrl}}/Auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authJwtToken}}
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/Auth/me
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "id": "",
          "firstName": "",
          "lastName": "",
          "birthday": "",
          "email": "",
          "description": "",
          "tags": []
        }
      '''
    }
  }
}

