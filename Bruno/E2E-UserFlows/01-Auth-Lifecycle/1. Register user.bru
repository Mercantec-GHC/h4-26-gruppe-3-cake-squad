meta {
  name: 1. Register user
  type: http
  seq: 1
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/Auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "firstName": "{{e2eFirstName}}",
    "lastName": "{{e2eLastName}}",
    "email": "{{e2eEmail}}",
    "password": "{{e2ePassword}}",
    "birthday": "{{e2eBirthday}}"
  }
}

script:post-response {
  if (res.status === 200 || res.status === 201) {
      const d = typeof res.body === "string" ? JSON.parse(res.body) : (res.body || {});
      const userId = d?.userId;
      const validationCode = d?.validationCode;
    
      if (userId) bru.setEnvVar("userId", String(userId));
      if (validationCode) bru.setEnvVar("validationCode", String(validationCode));
    }
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/Auth/register
    method: POST
    mode: json
    body:json: {
      {
        "firstName": "",
        "lastName": "",
        "email": "",
        "password": "",
        "birthday": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "userId": "",
          "validationCode": ""
        }
      '''
    }
  }
}

