meta {
  name: Delete E2E user
  type: http
  seq: 1
  tags: [
    Auth
  ]
}

delete {
  url: {{baseUrl}}/Auth/deleteAccount
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authJwtToken}}
}

body:json {
  {
    "currentPassword": "{{e2ePassword}}"
  }
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/Auth/deleteAccount
    method: DELETE
    mode: json
    body:json: {
      {
        "currentPassword": ""
      }
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
