meta {
  name: Authenticates a user with the provided credentials and returns an authentication token if successful.
  type: http
  seq: 3
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/Auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "",
    "password": ""
  }
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/Auth/login
    method: POST
    mode: json
    body:json: {
      {
        "email": "",
        "password": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "jwtToken": "",
          "refreshToken": "",
          "expires": 0
        }
      '''
    }
  }
}

