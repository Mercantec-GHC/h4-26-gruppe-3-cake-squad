meta {
  name: Registers a new user account using the provided registration details.
  type: http
  seq: 1
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/Auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "firstName": "",
    "lastName": "",
    "email": "",
    "password": "",
    "birthday": ""
  }
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/Auth/register
    method: POST
    mode: json
    body:json: {
      {
        "firstName": "",
        "lastName": "",
        "email": "",
        "password": "",
        "birthday": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "userId": "",
          "validationCode": ""
        }
      '''
    }
  }
}

