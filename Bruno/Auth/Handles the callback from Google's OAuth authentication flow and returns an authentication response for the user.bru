meta {
  name: Handles the callback from Google's OAuth authentication flow and returns an authentication response for the user.
  type: http
  seq: 10
  tags: [
    Auth
  ]
}

post {
  url: {{baseUrl}}/Auth/google/callback
  body: json
  auth: inherit
}

body:json {
  {
    "code": ""
  }
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/Auth/google/callback
    method: POST
    mode: json
    body:json: {
      {
        "code": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        {
          "jwtToken": "",
          "refreshToken": "",
          "expires": 0
        }
      '''
    }
  }
}

