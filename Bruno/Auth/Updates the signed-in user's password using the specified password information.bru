meta {
  name: Updates the signed-in user's password using the specified password information.
  type: http
  seq: 6
  tags: [
    Auth
  ]
}

put {
  url: {{baseUrl}}/Auth/updatePassword
  body: json
  auth: inherit
}

body:json {
  {
    "currentPassword": "",
    "newPassword": "",
    "confirmNewPassword": ""
  }
}

example {
  name: 200 Response
  description: OK
  
  request: {
    url: {{baseUrl}}/Auth/updatePassword
    method: PUT
    mode: json
    body:json: {
      {
        "currentPassword": "",
        "newPassword": "",
        "confirmNewPassword": ""
      }
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
